APP_ENV=local
APP_NAME=brownfield-order-service
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=mysql+pymysql://orders_user:orders_password@mysql:3306/orders_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_ORDER_STATUS_UPDATED=order.status_updated
KAFKA_CONSUMER_GROUP=order-service-consumer
